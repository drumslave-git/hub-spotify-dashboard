{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hubdash-preview",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "server.py",
        "--no-keeper"
      ],
      "port": 8765
    },
    {
      "name": "hubdash-preview-alt",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-c",
        "import os, sys; os.environ['PORT'] = '8791'; sys.argv = ['server.py', '--no-keeper']; import server; server.main()"
      ],
      "port": 8791
    },
    {
      "name": "hubdash-tone",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "server.py",
        "--no-keeper",
        "--test-tone"
      ],
      "port": 8765
    },
    {
      "name": "hubdash",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8765
    },
    {
      "name": "hubdash-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
