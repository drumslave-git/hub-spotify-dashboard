# Copy to .env next to docker-compose.yml and fill in. Compose reads it at runtime;
# nothing here is baked into the image.

# ---- Required: compose refuses to start without these ----

# The Nest Hub's IP address (give it a fixed DHCP lease).
HUB_HOST=192.168.1.50

# Address the Hub loads the dashboard from. Spotify's sign-in only returns to
# an https address, and the Hub only trusts publicly issued certificates.
PUBLIC_URL=https://hub.example.com/

# Timezone of the clock.
TZ=Europe/London

# Weather location: the label shown on screen and its coordinates.
WEATHER_NAME=London
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278

# Client ID of your Spotify app from developer.spotify.com/dashboard (no secret).
# In that app, add the redirect URI <PUBLIC_URL>api/spotify/callback
SPOTIFY_CLIENT_ID=

# ---- Optional: uncomment to change the default ----

# Image to run; pin a release with e.g. ghcr.io/<owner>/hub-spotify-dashboard:0.1.0
#HUBDASH_IMAGE=
# Folder that holds the Spotify sign-in.
#DATA_PATH=./data
#PORT=8765
#HOUR12=false
# Only if Spotify should return somewhere other than <PUBLIC_URL>api/spotify/callback
#SPOTIFY_REDIRECT_URI=
#SPOTIFY_PLAYER_NAME=Dashboard
#PLAYER_API_PORT=3678
# Your own registered Cast app ID (default: the public DashCast app).
#CAST_APP_ID=
#VOICE_TAKEOVER=true
