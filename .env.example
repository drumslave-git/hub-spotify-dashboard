# Copy to .env next to docker-compose.yml and fill in. Compose reads it at runtime;
# nothing here is baked into the image.

# Image to run. Empty = the published ghcr.io image named in docker-compose.yml.
# Pin a release with e.g. ghcr.io/<owner>/hub-spotify-dashboard:0.1.0
HUBDASH_IMAGE=

TZ=Europe/London
PORT=8765

# The Nest Hub's IP address (give it a fixed DHCP lease).
HUB_HOST=192.168.1.50

# Address the Hub loads the dashboard from. Use the HTTPS name for Spotify
# playback inside the dashboard; leave empty to auto-detect a plain http address.
PUBLIC_URL=https://hub.example.com/

WEATHER_NAME=London
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
HOUR12=false

# Spotify app from developer.spotify.com/dashboard (client ID only, no secret).
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://hub.example.com/api/spotify/callback
SPOTIFY_PLAYER_NAME=Dashboard

# Your own registered Cast app ID (empty = public DashCast app).
CAST_APP_ID=
VOICE_TAKEOVER=true
